rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images — authenticated users (including anonymous) can upload.
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Flagged-listing photos (moderation audit trail). Read stays open
    // for listFlaggedListings' <img> tags; that page is token-gated.
    match /flagged_listings/{docId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Profile photos (profile_photos/{uid}.jpg). Public read, write
    // restricted to the matching uid.
    match /profile_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }
    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
