rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images — authenticated users (including anonymous) can upload.
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Flagged-listing photos (moderation audit trail) — same shape as
    // products above. Read stays open since listFlaggedListings renders
    // these as <img> tags for review; the review page itself is
    // token-gated separately.
    match /flagged_listings/{docId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Profile/store photos, uploaded as profile_photos/{uid}.jpg. Read is
    // public (shown on the storefront's WooCommerce Brand image, not just
    // in-app). Write is restricted to the matching uid, unlike the looser
    // any-authenticated-user pattern above, since the filename here maps
    // directly to one specific account.
    match /profile_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }
    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
