rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // One profile doc per Firebase Auth user; owner-only access.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Write-only diagnostic log (SyncLogger) - clients create, never read.
    match /sync_errors/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Write-only moderation audit log, same shape as sync_errors.
    // Reviewed via the listFlaggedListings Cloud Function (Admin SDK).
    match /flagged_listings/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
